NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PDF bulk email (Resend) — required for /pdf "고객에게 PDF 발송"
RESEND_API_KEY=re_xxxxxxxx
# Verified sender, e.g. "PDF Split <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=PDF Split <noreply@yourdomain.com>
# Optional overrides
# PDF_EMAIL_SUBJECT=[PDF] {customerCode} document
# PDF_EMAIL_HTML=<p>Attached PDF for {customerCode}</p>
